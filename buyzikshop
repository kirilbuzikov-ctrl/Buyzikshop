<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buyzikshop</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root { --tg-theme-bg-color: #ffffff; --tg-theme-text-color: #000000; --accent-color: #e32636; }
        body { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif; background-color: var(--tg-theme-bg-color); color: var(--tg-theme-text-color); margin: 0; padding: 0; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-bottom: 1px solid #f0f0f0; position: sticky; top: 0; background: white; z-index: 10; }
        .logo { font-size: 22px; font-weight: bold; }
        .cart-icon { font-size: 22px; position: relative; cursor: pointer; }
        .cart-badge { position: absolute; top: -5px; right: -8px; background: black; color: white; font-size: 11px; padding: 2px 6px; border-radius: 5px; font-weight: bold; }
        .catalog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 15px; }
        .card { border: 1px solid #f0f0f0; border-radius: 8px; padding: 8px; display: flex; flex-direction: column; justify-content: space-between; }
        .price-box { display: flex; align-items: center; gap: 6px; margin: 4px 0; }
        .new-price { font-weight: bold; color: var(--accent-color); font-size: 16px; }
        .btn-action { width: 100%; background: black; color: white; border: none; padding: 12px; border-radius: 8px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 15px; }
        .cart-page { padding: 15px; display: none; }
        .input-field { width: 100%; padding: 10px; margin: 8px 0; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
    </style>
</head>
<body>

<header>
    <div class="logo">Buyzikshop</div>
    <div class="cart-icon" onclick="viewCart()">🛍️<span class="cart-badge" id="cart-count">0</span></div>
</header>

<div id="catalog-page">
    <div class="catalog-grid" id="catalog-grid">
        <div class="card">
            <img src="https://via.placeholder.com/150" style="width:100%; height:140px; object-fit:cover; border-radius:6px;">
            <div style="font-weight:bold; margin-top:8px; font-size:14px;">Худи / Кроссовки / Вещи</div>
            <div class="price-box"><span class="new-price">1200₴</span></div>
            <div style="font-size: 12px; color: #2ec4b6; margin-bottom: 8px;">● В наличии</div>
            <button class="btn-action" style="padding:6px; margin-top:auto; font-size:12px;" onclick="addToCart(1, 'Стильная вещь', 1200)">В корзину</button>
        </div>
    </div>
</div>

<div id="cart-page" class="cart-page">
    <h2 style="margin-top: 0;">КОРЗИНА</h2>
    <div id="cart-items-container"></div>
    <div style="display: flex; justify-content: space-between; font-size: 18px; font-weight: bold; margin-top: 15px;">
        <span>Итого к оплате:</span>
        <span style="color: var(--accent-color);"><span id="cart-total">0</span>₴</span>
    </div>
    
    <h4 style="margin: 20px 0 10px 0;">Доставка Новая Почта:</h4>
    <input type="text" id="order-fio" class="input-field" placeholder="ФИО получателя">
    <input type="tel" id="order-phone" class="input-field" placeholder="Номер телефона">
    <input type="text" id="order-city" class="input-field" placeholder="Город">
    <input type="text" id="order-post" class="input-field" placeholder="Номер отделения НП">
    
    <button class="btn-action" onclick="checkout()">ОПЛАТИТЬ</button>
    <button class="btn-action" style="background: #aaa; margin-top: 8px;" onclick="viewCatalog()">Назад в каталог</button>
</div>

<script>
    const tg = window.Telegram.WebApp;
    tg.expand();

    let cart = [];

    function addToCart(id, title, price) {
        cart.push({id, title, price});
        document.getElementById('cart-count').innerText = cart.length;
        if(tg.HapticFeedback) tg.HapticFeedback.notificationOccurred("success");
    }

    function viewCart() {
        document.getElementById('catalog-page').style.display = 'none';
        document.getElementById('cart-page').style.display = 'block';
        const container = document.getElementById('cart-items-container');
        container.innerHTML = '';
        let total = 0;
        
        if(cart.length === 0) {
            container.innerHTML = '<p style="text-align:center; color:#999;">Корзина пуста</p>';
        }
        
        cart.forEach((item, index) => {
            container.innerHTML += `
                <div style="display:flex; justify-content:space-between; border:1px solid #eee; padding:10px; border-radius:8px; margin-bottom:10px;">
                    <div><b>${item.title}</b><br><span style="color:var(--accent-color); font-weight:bold;">${item.price}₴</span></div>
                    <span style="color:red; cursor:pointer;" onclick="removeFromCart(${index})">✕</span>
                </div>
            `;
            total += item.price;
        });
        document.getElementById('cart-total').innerText = total;
    }

    function removeFromCart(index) {
        cart.splice(index, 1);
        document.getElementById('cart-count').innerText = cart.length;
        viewCart();
    }

    function viewCatalog() {
        document.getElementById('catalog-page').style.display = 'block';
        document.getElementById('cart-page').style.display = 'none';
    }

    function checkout() {
        const fio = document.getElementById('order-fio').value;
        const phone = document.getElementById('order-phone').value;
        const city = document.getElementById('order-city').value;
        const post = document.getElementById('order-post').value;

        if(!fio || !phone || !city || !post) { alert("Заполните данные доставки!"); return; }
        if(cart.length === 0) { alert("Корзина пуста!"); return; }

        alert("Заказ принят! Скоро мы запустим сервер, чтобы он приходил тебе в ТГ.");
    }
</script>
</body>
</html>
